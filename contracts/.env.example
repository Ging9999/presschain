# Copy to `.env` and fill in before deploying. `.env` is git-ignored.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Funded Base Sepolia deployer key (0x + 64 hex). Testnet ETH:
# https://docs.base.org/tools/network-faucets
DEPLOYER_PRIVATE_KEY=

# Optional: BaseScan API key for `hardhat verify` (free from basescan.org/myapikey).
BASESCAN_API_KEY=
