# Copy to `.env` and fill in. `.env` is git-ignored — NEVER commit real secrets.
# Used by scripts/smoke-e2e.ts (and read via dotenv).

# A FUNDED Base Sepolia test wallet private key (0x + 64 hex).
# Get testnet ETH from a Base Sepolia faucet: https://docs.base.org/tools/network-faucets
# This account signs the on-chain uploadArticle/flagArticle transactions.
DEPLOYER_PRIVATE_KEY=

# Optional RPC override (defaults to the public Base Sepolia RPC).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Base64 Web3.Storage (w3up) delegation proof for your space, granting
# space/blob/add + upload/add. Obtain it by completing IPFS setup once in the app
# (Settings → IPFS, which stores this) or via the w3 CLI, then paste it here.
W3UP_PROOF=

# Optional SOCKS proxy override (defaults to the bundled Tor at socks5h://127.0.0.1:19051).
# TOR_SOCKS_PROXY=socks5h://127.0.0.1:19051
